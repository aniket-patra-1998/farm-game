# gdlint (GDScript Toolkit) settings: CI runs `gdlint` on every push.
max-line-length: 300  # target 120: long lines left are player-facing text, moving to a strings file
max-file-lines: 3600
max-public-methods: 300
max-returns: 20
function-arguments-number: 10
disable:
  - no-elif-return
  - no-else-return
  - unused-argument
