# Godot 4
.godot/
*.import.tmp
*.apk
*.aab
.DS_Store
Thumbs.db

# CI cache folder
godot-bin/
ci_shots/
baked/
vendor/
art_src/
tools/resolved.txt

# Godot import files for the art reference sketches: made locally, never needed in git
art/refs/**/*.import
art/refs3d/**/*.import
art/style/**/*.import
art/pilot/**/*.import

# Built from locale/strings.csv when Godot imports the project
locale/*.translation
__pycache__/

# The Android build template (installed by CI for the gradle export) and the plugin built from android/plugins
android/build/
android/.build_version
android/plugins/*/build/
android/plugins/*/.gradle/
addons/farm_notices/bin/
addons/admob/internal/translations/*.translation
