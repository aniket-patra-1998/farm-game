    "error": {"sound": "error", "buzz": 40},
    "plow": {"sound": "plow", "buzz": 8},
    "plant": {"sound": "plant", "buzz": 8},
    "fertilize": {"sound": "fertilize", "buzz": 8},
    "collect": {"sound": "collect", "buzz": 16},
    "collect_soft": {"sound": "collect", "buzz": 24},
