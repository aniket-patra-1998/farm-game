; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Farm Game"
config/description="Single-player farming game (working title)."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.133, 0.078, 0.231, 1)
boot_splash/stretch_mode=0
boot_splash/image="res://art/app_icon/splash.png"
config/icon="res://art/app_icon/icon.png"

[autoload]

StartClock="*res://autoload/start_clock.gd"
Game="*res://autoload/game.gd"
Sound="*res://autoload/sound.gd"
Feedback="*res://autoload/feedback.gd"

[debug]

file_logging/enable_file_logging=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[editor_plugins]

enabled=PackedStringArray("res://addons/GameAnalytics/plugin.cfg", "res://addons/NotificationSchedulerPlugin/plugin.cfg", "res://addons/GodotGooglePlayBilling/plugin.cfg", "res://addons/InappReviewPlugin/plugin.cfg", "res://addons/admob/plugin.cfg")

[farm]

art/use_painted_art=false
world/use_3d=true

[gui]

theme/custom_font="res://fonts/Poppins-Medium.ttf"

[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/translations=PackedStringArray("res://locale/strings.en.translation")

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.75, 0.89, 0.96, 1)

[shader_globals]

finish_grain={
"type": "float",
"value": 1.0
}
wind={
"type": "float",
"value": 0.6
}
crop_clock={
"type": "float",
"value": 0.0
}
dark={
"type": "float",
"value": 0.0
}
wetness={
"type": "float",
"value": 0.0
}
rain={
"type": "float",
"value": 0.0
}
snow_cover={
"type": "float",
"value": 0.0
}
